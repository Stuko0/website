---
import PublicLayout from "../layouts/PublicLayout.astro"
import Breadcrumbs from "../components/ui/Breadcrumbs.astro"
import { Icon } from "astro-icon/components"
---

<PublicLayout title="Mi Perfil">
  <div class="bg-primary pt-24 pb-6">
    <div class="container mx-auto px-4">
      <Breadcrumbs crumbs={[
        { label: "Inicio", href: "/" },
        { label: "Mi Perfil" }
      ]} />
      <h1 class="font-heading text-4xl text-accent">Mi Perfil</h1>
    </div>
  </div>

  <div class="container mx-auto px-4 py-8">
    <div class="flex flex-col lg:flex-row gap-8">
      <!-- Sidebar -->
      <aside class="w-full lg:w-64 shrink-0">
        <nav class="space-y-1 bg-white rounded-sm border border-border p-2">
          <a href="#datos" class="flex items-center gap-3 px-4 py-3 rounded bg-accent/20 text-primary font-semibold transition-colors">
            <Icon name="mdi:account-outline" class="text-xl" /> Mis Datos
          </a>
          <a href="#direcciones" class="flex items-center gap-3 px-4 py-3 rounded text-muted hover:bg-accent/10 hover:text-primary transition-colors">
            <Icon name="mdi:map-marker-outline" class="text-xl" /> Direcciones
          </a>
          <a href="#pedidos" class="flex items-center gap-3 px-4 py-3 rounded text-muted hover:bg-accent/10 hover:text-primary transition-colors">
            <Icon name="mdi:package-variant-closed" class="text-xl" /> Mis Pedidos
          </a>
          <a href="/login" class="flex items-center gap-3 px-4 py-3 rounded text-muted hover:bg-red-50 hover:text-red-600 transition-colors">
            <Icon name="mdi:logout" class="text-xl" /> Cerrar Sesión
          </a>
        </nav>
      </aside>

      <!-- Contenido -->
      <main class="flex-1 space-y-8" id="profile-content">
        <div class="text-center py-10 text-muted" id="profile-loading">
          <p class="text-lg">Cargando perfil...</p>
        </div>

        <!-- Mis Datos -->
        <section id="datos" class="bg-white border border-border rounded-sm p-6 hidden">
          <h2 class="text-xl font-bold text-heading mb-6">Mis Datos</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-lg">
            <div class="md:col-span-2">
              <label class="block text-sm font-semibold text-muted mb-1">Nombre completo</label>
              <input type="text" id="profile-name" class="w-full px-4 py-2.5 border border-border rounded-sm focus:border-accent focus:outline-none transition-colors" />
            </div>
            <div class="md:col-span-2">
              <label class="block text-sm font-semibold text-muted mb-1">Email</label>
              <input type="email" id="profile-email" class="w-full px-4 py-2.5 border border-border rounded-sm focus:border-accent focus:outline-none transition-colors" />
            </div>
            <div class="md:col-span-2">
              <label class="block text-sm font-semibold text-muted mb-1">Teléfono</label>
              <input type="tel" id="profile-phone" class="w-full px-4 py-2.5 border border-border rounded-sm focus:border-accent focus:outline-none transition-colors" />
            </div>
          </div>
          <button id="profile-save-btn" class="mt-4 bg-primary text-cream px-6 py-2.5 font-bold uppercase tracking-wider text-sm hover:bg-primary-light transition-colors rounded-sm">
            Guardar Cambios
          </button>
          <p id="profile-save-feedback" class="mt-2 text-sm text-green-600 hidden"></p>
        </section>

        <!-- Direcciones -->
        <section id="direcciones" class="bg-white border border-border rounded-sm p-6 hidden">
          <div class="flex items-center justify-between mb-6">
            <h2 class="text-xl font-bold text-heading">Mis Direcciones</h2>
            <button class="border-2 border-dashed border-border rounded-sm p-2 text-muted hover:border-accent hover:text-primary transition-colors cursor-pointer" title="Agregar dirección">
              <Icon name="mdi:plus" class="text-xl" />
            </button>
          </div>
          <div class="border border-border rounded-sm p-4 max-w-lg" id="profile-address-container">
            <div class="flex justify-between items-start">
              <div id="profile-address-display">
                <p class="text-muted text-sm">No has agregado una dirección aún.</p>
              </div>
            </div>
          </div>
        </section>

        <!-- Mis Pedidos -->
        <section id="pedidos" class="bg-white border border-border rounded-sm p-6 hidden">
          <h2 class="text-xl font-bold text-heading mb-6">Mis Pedidos</h2>
          <div id="profile-orders-container">
            <p class="text-muted text-sm">Cargando pedidos...</p>
          </div>
        </section>
      </main>
    </div>
  </div>
</PublicLayout>

<script>
  import { isAuthenticated, currentUser, fetchWithAuth } from '../lib/api.ts'

  async function loadProfile() {
    if (!isAuthenticated()) {
      window.location.href = '/login'
      return
    }

    const user = currentUser()
    const loading = document.getElementById('profile-loading')
    const datosSection = document.getElementById('datos')
    const direccionesSection = document.getElementById('direcciones')
    const pedidosSection = document.getElementById('pedidos')

    // Fill from JWT first
    const nameInput = document.getElementById('profile-name') as HTMLInputElement
    const emailInput = document.getElementById('profile-email') as HTMLInputElement
    const phoneInput = document.getElementById('profile-phone') as HTMLInputElement
    if (user) {
      nameInput.value = user.name || ''
      emailInput.value = user.email || ''
    }

    // Fetch full profile from API
    try {
      const profile = await fetchWithAuth('/api/profile')
      if (profile.name) nameInput.value = profile.name
      if (profile.email) emailInput.value = profile.email
      if (profile.phone) phoneInput.value = profile.phone
      if (profile.address || profile.city) {
        const addrDisplay = document.getElementById('profile-address-display')
        addrDisplay.innerHTML = `
          <p class="font-semibold text-primary">${profile.name || ''}</p>
          <p class="text-sm text-muted">${profile.address || ''}</p>
          <p class="text-sm text-muted">${profile.city || ''}</p>
          <p class="text-sm text-muted">${profile.phone ? 'Tel: ' + profile.phone : ''}</p>
        `
      }
    } catch (e) {
      console.warn('Profile API unavailable, using JWT data')
    }

    // Load orders
    try {
      const orders = await fetchWithAuth('/api/orders')
      const container = document.getElementById('profile-orders-container')
      if (orders && orders.length > 0) {
        container.innerHTML = orders.map((order: any) => {
          const statusColors: Record<string, string> = { 'pending': 'bg-yellow-100 text-yellow-700', 'shipped': 'bg-blue-100 text-blue-700', 'delivered': 'bg-green-100 text-green-700' }
          const statusClass = statusColors[order.status] || 'bg-border text-muted'
          const items = order.items || []
          return `
            <div class="border border-border rounded-sm p-4 mb-4">
              <div class="flex justify-between items-start mb-3">
                <div>
                  <p class="font-semibold text-primary">Pedido #${(order.id || '').slice(0, 8)}</p>
                  <p class="text-sm text-muted">${order.created ? new Date(order.created).toLocaleDateString() : ''}</p>
                </div>
                <span class="px-3 py-1 text-sm font-semibold rounded-sm ${statusClass}">${order.status || 'pending'}</span>
              </div>
              ${Array.isArray(items) ? items.map((item: any) => `
                <div class="flex items-center gap-3 mb-2">
                  <div class="text-sm">
                    <p class="font-semibold">${item.name || 'Producto'} × ${item.quantity || 1}</p>
                    <p class="text-muted">Bs ${((item.price || 0) * (item.quantity || 1)).toFixed(2)}</p>
                  </div>
                </div>
              `).join('') : '<p class="text-sm text-muted">Detalles no disponibles</p>'}
              <div class="border-t border-border mt-3 pt-3 flex justify-between items-center">
                <span class="text-sm font-bold text-body">Total: Bs ${(order.total || 0).toFixed(2)}</span>
              </div>
            </div>
          `
        }).join('')
      } else {
        container.innerHTML = '<p class="text-muted text-sm">No tienes pedidos aún.</p>'
      }
    } catch (e) {
      document.getElementById('profile-orders-container').innerHTML = '<p class="text-muted text-sm">No tienes pedidos aún.</p>'
    }

    // Show sections
    loading.classList.add('hidden')
    datosSection.classList.remove('hidden')
    direccionesSection.classList.remove('hidden')
    pedidosSection.classList.remove('hidden')
  }

  // Save profile
  document.getElementById('profile-save-btn')?.addEventListener('click', async () => {
    const name = (document.getElementById('profile-name') as HTMLInputElement).value
    const email = (document.getElementById('profile-email') as HTMLInputElement).value
    const phone = (document.getElementById('profile-phone') as HTMLInputElement).value
    const feedback = document.getElementById('profile-save-feedback')

    try {
      await fetchWithAuth('/api/profile', {
        method: 'PUT',
        body: JSON.stringify({ name, email, phone }),
      })
      feedback.textContent = '✅ Datos guardados correctamente'
      feedback.classList.remove('hidden')
      setTimeout(() => feedback.classList.add('hidden'), 3000)
    } catch (e: any) {
      feedback.textContent = '❌ Error al guardar: ' + (e.message || 'desconocido')
      feedback.classList.remove('hidden')
    }
  })

  loadProfile()
</script>
