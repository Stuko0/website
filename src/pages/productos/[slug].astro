---
import PublicLayout from "../../layouts/PublicLayout.astro"
import Breadcrumbs from "../../components/ui/Breadcrumbs.astro"
import ProductGallery from "../../components/ui/ProductGallery.astro"
import ProductInfo from "../../components/ui/ProductInfo.astro"
import ProductTabs from "../../components/ui/ProductTabs.astro"
import ProductCard from "../../components/ui/ProductCard.astro"

export async function getStaticPaths() {
  const products = [
    { id: "1", name: "Chocolate Amargo 70%", price: 35, compareAtPrice: 45, slug: "chocolate-amargo-70", category: "Chocolate", description: "Chocolate amargo con 70% de contenido de cacao. Intenso, con notas afrutadas y un final persistente.", images: ["https://images.pexels.com/photos/6261615/pexels-photo-6261615.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=1", "https://images.pexels.com/photos/6261692/pexels-photo-6261692.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=1", "https://images.pexels.com/photos/65882/chocolate-dark-coffee-confiserie-65882.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=1"],
      variants: [{ label: "100g", price: 35 }, { label: "250g", price: 65 }, { label: "500g", price: 110 }],
      info: [{ label: "Peso", value: "100g / 250g / 500g" }, { label: "Origen", value: "Bolivia" }, { label: "Categoría", value: "Chocolate" }, { label: "Cacao", value: "70% mínimo" }] },
    { id: "2", name: "Cacao en Polvo Orgánico", price: 45, slug: "cacao-polvo-organico", category: "Cacao en polvo", description: "Cacao en polvo 100% orgánico, sin azúcares añadidos. Perfecto para repostería y bebidas.", images: ["https://images.pexels.com/photos/4110096/pexels-photo-4110096.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=1", "https://images.pexels.com/photos/4110089/pexels-photo-4110089.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=1"],
      variants: [{ label: "200g", price: 45 }, { label: "500g", price: 80 }],
      info: [{ label: "Peso", value: "200g / 500g" }, { label: "Origen", value: "Bolivia" }, { label: "Categoría", value: "Cacao en polvo" }, { label: "Certificación", value: "Orgánico USDA" }] },
    { id: "3", name: "Manteca de Cacao Pura", price: 55, slug: "manteca-cacao-pura", category: "Manteca de cacao", description: "Manteca de cacao pura, prensada en frío. Ideal para cosmética natural y repostería.", images: ["https://images.pexels.com/photos/10823180/pexels-photo-10823180.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=1", "https://images.pexels.com/photos/4113290/pexels-photo-4113290.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=1"],
      variants: [{ label: "100g", price: 55 }, { label: "250g", price: 100 }],
      info: [{ label: "Peso", value: "100g / 250g" }, { label: "Origen", value: "Bolivia" }, { label: "Categoría", value: "Manteca de cacao" }, { label: "Proceso", value: "Prensado en frío" }] },
    { id: "4", name: "Nibs de Cacao Tostado", price: 40, slug: "nibs-cacao-tostado", category: "Nibs", description: "Nibs de cacao orgánico tostados crocantes. Superfood rico en antioxidantes y magnesio.", images: ["https://images.pexels.com/photos/65882/chocolate-dark-coffee-confiserie-65882.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=1", "https://images.pexels.com/photos/6261618/pexels-photo-6261618.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=1"],
      variants: [{ label: "150g", price: 40 }, { label: "300g", price: 70 }],
      info: [{ label: "Peso", value: "150g / 300g" }, { label: "Origen", value: "Bolivia" }, { label: "Categoría", value: "Nibs" }, { label: "Beneficio", value: "Alto en antioxidantes" }] },
    { id: "5", name: "Bombones Rellenos Surtidos", price: 65, compareAtPrice: 80, slug: "bombones-rellenos-surtidos", category: "Bombones", description: "Caja de bombones artesanales con rellenos de ganache, praliné y frutos secos.", images: ["https://images.pexels.com/photos/7538069/pexels-photo-7538069.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=1", "https://images.pexels.com/photos/10303625/pexels-photo-10303625.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=1"],
      variants: [{ label: "6 unidades", price: 65 }, { label: "12 unidades", price: 110 }, { label: "24 unidades", price: 190 }],
      info: [{ label: "Peso", value: "150g / 300g / 600g" }, { label: "Origen", value: "Bolivia" }, { label: "Categoría", value: "Bombones" }, { label: "Contenido", value: "Ganache, praliné, frutos secos" }] },
    { id: "6", name: "Chocolate con Leche Artesanal", price: 30, slug: "chocolate-leche-artesanal", category: "Chocolate", description: "Chocolate con leche cremoso y suave, elaborado con leche de la región y cacao fino.", images: ["https://images.pexels.com/photos/6261691/pexels-photo-6261691.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=1", "https://images.pexels.com/photos/8900912/pexels-photo-8900912.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=1", "https://images.pexels.com/photos/50707/cocoa-man-colombia-peasant-50707.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=1"],
      variants: [{ label: "100g", price: 30 }, { label: "250g", price: 55 }],
      info: [{ label: "Peso", value: "100g / 250g" }, { label: "Origen", value: "Bolivia" }, { label: "Categoría", value: "Chocolate" }, { label: "Tipo", value: "Con leche artesanal" }] },
  ]
  return products.map(p => ({
    params: { slug: p.slug },
    props: { product: p }
  }))
}

const { product } = Astro.props
const relatedProducts = [
  { id: "1", name: "Chocolate Amargo 70%", price: 35, slug: "chocolate-amargo-70", image: "https://images.pexels.com/photos/6261615/pexels-photo-6261615.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=1", category: "Chocolate" },
  { id: "4", name: "Nibs de Cacao Tostado", price: 40, slug: "nibs-cacao-tostado", image: "https://images.pexels.com/photos/65882/chocolate-dark-coffee-confiserie-65882.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=1", category: "Nibs" },
  { id: "5", name: "Bombones Rellenos", price: 65, slug: "bombones-rellenos-surtidos", image: "https://images.pexels.com/photos/7538069/pexels-photo-7538069.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=1", category: "Bombones" },
  { id: "6", name: "Chocolate con Leche", price: 30, slug: "chocolate-leche-artesanal", image: "https://images.pexels.com/photos/6261691/pexels-photo-6261691.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=1", category: "Chocolate" },
].filter(r => r.slug !== product.slug).slice(0, 3)

// New arrivals for sidebar
const newArrivals = relatedProducts.slice(0, 2)
---

<PublicLayout title={product.name}>
  <!-- Header with breadcrumbs -->
  <div class="bg-primary pt-24 pb-6">
    <div class="container mx-auto px-4">
      <Breadcrumbs crumbs={[
        { label: "Inicio", href: "/" },
        { label: "Productos", href: "/productos" },
        { label: product.name }
      ]} />
    </div>
  </div>

  <!-- Product section -->
  <div class="container mx-auto px-4 py-8">
    <div class="flex flex-col lg:flex-row gap-10">
      <!-- Left: Gallery + sidebar stack -->
      <div class="w-full lg:w-3/5">
        <ProductGallery images={product.images} productName={product.name} />
      </div>

      <!-- Right: Info + sidebar -->
      <div class="w-full lg:w-2/5">
        <ProductInfo
          name={product.name}
          category={product.category}
          price={product.price}
          compareAtPrice={product.compareAtPrice}
          description={product.description}
          variants={product.variants}
          slug={product.slug}
        />

        <!-- Sidebar widgets below info -->
        <div class="mt-8 pt-6 border-t border-border">
          <h3 class="text-lg font-bold text-heading mb-3">Categorías</h3>
          <ul class="space-y-1">
            <li><a href="/productos" class="text-sm text-muted hover:text-accent transition-colors">Todos</a></li>
            <li><a href="/productos?categoria=chocolate" class="text-sm text-muted hover:text-accent transition-colors">Chocolate</a></li>
            <li><a href="/productos?categoria=cacao-en-polvo" class="text-sm text-muted hover:text-accent transition-colors">Cacao en polvo</a></li>
            <li><a href="/productos?categoria=manteca-de-cacao" class="text-sm text-muted hover:text-accent transition-colors">Manteca de cacao</a></li>
            <li><a href="/productos?categoria=bombones" class="text-sm text-muted hover:text-accent transition-colors">Bombones</a></li>
          </ul>
        </div>

        {newArrivals.length > 0 && (
          <div class="mt-6 pt-6 border-t border-border">
            <h3 class="text-lg font-bold text-heading mb-3">Novedades</h3>
            <div class="space-y-3">
              {newArrivals.map(na => (
                <a href={`/productos/${na.slug}`} class="flex items-center gap-3 group">
                  <img src={na.image} alt={na.name} class="w-14 h-14 object-cover rounded-sm shrink-0" loading="lazy" />
                  <div>
                    <p class="text-sm font-semibold text-primary group-hover:text-accent transition-colors">{na.name}</p>
                    <p class="text-xs text-muted">Bs {na.price.toFixed(2)}</p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>

    <!-- Tabs: Description / Info / Reviews -->
    <div class="mt-16 border-t border-border pt-8">
      <ProductTabs description={product.description + " Elaborado con cacao fino de aroma cultivado en las tierras altas de Bolivia. Procesado artesanalmente para preservar sus propiedades organolépticas únicas. Libre de aditivos y conservantes artificiales."} additionalInfo={product.info} />
    </div>

    <!-- Related Products -->
    <div class="mt-16">
      <h2 class="font-heading text-3xl text-heading mb-6">Productos Relacionados</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {relatedProducts.map(rp => (
          <ProductCard product={{
            id: rp.slug,
            name: rp.name,
            slug: rp.slug,
            price: rp.price,
            image: rp.image,
            category: rp.category,
          }} />
        ))}
      </div>
    </div>
  </div>
</PublicLayout>
