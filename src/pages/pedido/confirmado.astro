---
import PublicLayout from "../../layouts/PublicLayout.astro"
import Breadcrumbs from "../../components/ui/Breadcrumbs.astro"
import { Icon } from "astro-icon/components"

const orderId = Astro.url.searchParams.get('id') || ''
---

<PublicLayout title="Pedido Confirmado">
  <div class="bg-primary pt-24 pb-6">
    <div class="container mx-auto px-4">
      <Breadcrumbs crumbs={[
        { label: "Inicio", href: "/" },
        { label: "Pedido Confirmado" }
      ]} />
    </div>
  </div>

  <div class="container mx-auto px-4 py-16 text-center">
    <div class="max-w-md mx-auto">
      <div class="w-20 h-20 rounded-full bg-green-100 flex items-center justify-center mx-auto mb-6">
        <svg class="w-10 h-10 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
      </div>
      <h1 class="font-heading text-4xl text-primary mb-3">¡Pedido Confirmado!</h1>
      <p class="text-muted mb-2">Gracias por tu compra. Te enviaremos un correo con los detalles.</p>
      <p class="text-sm text-muted mb-8">Número de pedido: <strong class="text-primary font-mono" id="order-id">{orderId ? orderId.slice(0, 8) : '—'}</strong></p>
      <div class="space-y-3">
        <a href="/perfil" class="block w-full bg-primary text-cream py-3 font-bold uppercase tracking-wider text-sm hover:bg-primary-light rounded-sm">Ver mis pedidos</a>
        <a href="/productos" class="block w-full border-2 border-primary text-primary py-3 font-bold uppercase tracking-wider text-sm hover:bg-primary hover:text-cream rounded-sm">Seguir comprando</a>
      </div>
    </div>
  </div>
</PublicLayout>
