---
import PublicLayout from "../layouts/PublicLayout.astro"
import Breadcrumbs from "../components/ui/Breadcrumbs.astro"
import { getCollection } from "astro:content"

const allRecipes = await getCollection("recipes")
const recipes = allRecipes.filter(r => r.data.published).map(r => ({
  title: r.data.title,
  slug: r.data.slug,
  excerpt: r.data.summary,
  image: r.data.image || "",
  time: r.data.prep_time,
  difficulty: r.data.difficulty,
}))
const difficultyColors: Record<string, string> = {
  "Fácil": "bg-green-100 text-green-700",
  "Media": "bg-accent/20 text-primary",
  "Difícil": "bg-red-100 text-red-600",
}
---

<PublicLayout title="Recetas">
  <div class="bg-primary pt-24 pb-8">
    <div class="container mx-auto px-4">
      <Breadcrumbs crumbs={[
        { label: "Inicio", href: "/" },
        { label: "Recetas" }
      ]} />
      <h1 class="font-heading text-5xl text-accent mb-2">Recetas con Cacao</h1>
      <p class="text-cream/80 text-lg max-w-2xl">Descubre deliciosas recetas elaboradas con nuestros productos de cacao.</p>
    </div>
  </div>

  <div class="container mx-auto px-4 py-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {recipes.map(r => (
        <a href={`/recetas/${r.slug}`} class="group rounded-sm overflow-hidden shadow-sm hover:shadow-lg transition-all duration-300 bg-white">
          <div class="overflow-hidden aspect-[4/3]">
            <img src={r.image} alt={r.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
          </div>
          <div class="p-5">
            <div class="flex flex-wrap items-center gap-3 text-xs text-muted mb-3">
              <span class="flex items-center gap-1">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                {r.time}
              </span>
              <span class={`px-2.5 py-0.5 rounded-full text-xs font-semibold ${difficultyColors[r.difficulty] || 'bg-border text-muted'}`}>
                {r.difficulty}
              </span>
            </div>
            <h3 class="text-xl font-semibold text-primary group-hover:text-accent transition-colors mb-2 leading-tight">{r.title}</h3>
            <p class="text-muted text-sm leading-relaxed line-clamp-2">{r.excerpt}</p>
          </div>
        </a>
      ))}
    </div>
    {recipes.length === 0 && (
      <div class="text-center py-20">
        <p class="text-muted text-lg">No hay recetas publicadas aún.</p>
      </div>
    )}
  </div>
</PublicLayout>
