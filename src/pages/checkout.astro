---
import PublicLayout from "../layouts/PublicLayout.astro"
import Breadcrumbs from "../components/ui/Breadcrumbs.astro"
import { Icon } from "astro-icon/components"
---

<PublicLayout title="Checkout">
  <div class="bg-primary pt-24 pb-6">
    <div class="container mx-auto px-4">
      <Breadcrumbs crumbs={[
        { label: "Inicio", href: "/" },
        { label: "Carrito", href: "/carrito" },
        { label: "Checkout" }
      ]} />
      <h1 class="font-heading text-4xl text-accent">Checkout</h1>
    </div>
  </div>

  <div class="container mx-auto px-4 py-8">
    <div id="checkout-empty" class="hidden text-center py-20">
      <Icon name="mdi:cart-outline" class="text-6xl text-border mx-auto mb-4" />
      <h2 class="text-2xl font-bold text-heading mb-2">Tu carrito está vacío</h2>
      <a href="/productos" class="inline-block bg-primary text-cream px-8 py-3 font-bold uppercase tracking-wider text-sm hover:bg-primary-light">Ver Productos</a>
    </div>

    <div id="checkout-form" class="flex flex-col lg:flex-row gap-8">
      <div class="flex-1 max-w-2xl">
        <!-- Envío -->
        <div class="mb-8">
          <h2 class="text-lg font-bold text-heading mb-4 flex items-center gap-3">
            <span class="w-8 h-8 rounded-full bg-accent text-primary flex items-center justify-center text-sm font-bold">1</span>
            Información de Envío
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="md:col-span-2">
              <label class="block text-sm font-semibold text-muted mb-1">Nombre completo</label>
              <input id="co-name" type="text" class="w-full px-4 py-2.5 border border-border rounded-sm focus:border-accent focus:outline-none" />
            </div>
            <div class="md:col-span-2">
              <label class="block text-sm font-semibold text-muted mb-1">Email</label>
              <input id="co-email" type="email" class="w-full px-4 py-2.5 border border-border rounded-sm focus:border-accent focus:outline-none" />
            </div>
            <div class="md:col-span-2">
              <label class="block text-sm font-semibold text-muted mb-1">Teléfono</label>
              <input id="co-phone" type="tel" class="w-full px-4 py-2.5 border border-border rounded-sm focus:border-accent focus:outline-none" />
            </div>
            <div class="md:col-span-2">
              <label class="block text-sm font-semibold text-muted mb-1">Dirección</label>
              <input id="co-address" type="text" class="w-full px-4 py-2.5 border border-border rounded-sm focus:border-accent focus:outline-none" />
            </div>
            <div>
              <label class="block text-sm font-semibold text-muted mb-1">Ciudad</label>
              <input id="co-city" type="text" class="w-full px-4 py-2.5 border border-border rounded-sm focus:border-accent focus:outline-none" />
            </div>
            <div>
              <label class="block text-sm font-semibold text-muted mb-1">Código Postal</label>
              <input id="co-zip" type="text" class="w-full px-4 py-2.5 border border-border rounded-sm focus:border-accent focus:outline-none" />
            </div>
          </div>
        </div>

        <!-- Método de pago -->
        <div class="mb-8">
          <h2 class="text-lg font-bold text-heading mb-4 flex items-center gap-3">
            <span class="w-8 h-8 rounded-full bg-accent text-primary flex items-center justify-center text-sm font-bold">2</span>
            Método de Pago
          </h2>
          <label class="flex items-center gap-3 p-4 border-2 border-accent rounded-sm cursor-pointer mb-2">
            <input type="radio" name="pago" value="transferencia" checked class="accent-primary" />
            <Icon name="mdi:bank" class="text-2xl text-primary" />
            <div class="flex-1">
              <p class="font-semibold text-primary">Transferencia Bancaria</p>
              <p class="text-xs text-muted">Transferencia a cuenta bancaria</p>
            </div>
          </label>
          <label class="flex items-center gap-3 p-4 border border-border rounded-sm cursor-pointer hover:border-accent mb-2">
            <input type="radio" name="pago" value="contraentrega" class="accent-primary" />
            <Icon name="mdi:cash" class="text-2xl text-primary" />
            <div class="flex-1">
              <p class="font-semibold text-primary">Pago contra entrega</p>
              <p class="text-xs text-muted">Paga en efectivo al recibir tu pedido</p>
            </div>
          </label>
          <label class="flex items-center gap-3 p-4 border border-border rounded-sm cursor-pointer hover:border-accent">
            <input type="radio" name="pago" value="stripe" class="accent-primary" />
            <Icon name="mdi:credit-card" class="text-2xl text-primary" />
            <div class="flex-1">
              <p class="font-semibold text-primary">Tarjeta de Crédito/Débito</p>
              <p class="text-xs text-muted">Paga con Visa, Mastercard o American Express vía Stripe</p>
            </div>
          </label>
        </div>

        <button id="co-submit-btn" class="w-full bg-primary text-cream py-4 font-bold text-base uppercase tracking-wider hover:bg-primary-light rounded-sm disabled:opacity-50 disabled:cursor-not-allowed" disabled>
          Procesando...
        </button>
        <p id="co-error" class="mt-2 text-sm text-red-600 hidden"></p>
      </div>

      <!-- Resumen dinámico -->
      <aside class="w-full lg:w-80 shrink-0">
        <div class="bg-cream border border-border rounded-sm p-6 sticky top-28">
          <h3 class="text-xl font-bold text-heading mb-4 pb-3 border-b border-border">Tu Pedido</h3>
          <div id="co-items" class="space-y-3 pb-4 border-b border-border"></div>
          <div class="space-y-3 pt-4 text-sm text-muted">
            <div class="flex justify-between"><span>Subtotal</span><span class="font-semibold text-body" id="co-subtotal">Bs 0.00</span></div>
            <div class="flex justify-between"><span>Envío</span><span class="font-semibold text-body">Bs 15.00</span></div>
            <div class="border-t border-border pt-3 flex justify-between font-bold text-lg text-body">
              <span>Total</span>
              <span id="co-total">Bs 0.00</span>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </div>

  <script>
    import { getCart, getCartTotal, clearCart } from '../lib/cart.ts'
    import { submitOrder, isAuthenticated } from '../lib/api.ts'

    function renderSummary() {
      const items = getCart()
      if (items.length === 0) {
        document.getElementById('checkout-form').classList.add('hidden')
        document.getElementById('checkout-empty').classList.remove('hidden')
        return
      }
      document.getElementById('checkout-form').classList.remove('hidden')
      document.getElementById('checkout-empty').classList.add('hidden')

      const container = document.getElementById('co-items')
      container.innerHTML = items.map(i => `
        <div class="flex justify-between text-sm">
          <span>${i.name} × ${i.quantity}</span>
          <span>Bs ${(i.price * i.quantity).toFixed(2)}</span>
        </div>
      `).join('')

      const subtotal = getCartTotal()
      const envio = 15
      document.getElementById('co-subtotal').textContent = `Bs ${subtotal.toFixed(2)}`
      document.getElementById('co-total').textContent = `Bs ${(subtotal + envio).toFixed(2)}`
      document.getElementById('co-submit-btn').textContent = isAuthenticated() ? 'Confirmar Pedido' : 'Iniciar Sesión para Comprar'
      document.getElementById('co-submit-btn').disabled = !isAuthenticated()
    }

    document.getElementById('co-submit-btn')?.addEventListener('click', async () => {
      if (!isAuthenticated()) { window.location.href = '/login'; return }

      const btn = document.getElementById('co-submit-btn') as HTMLButtonElement
      const errEl = document.getElementById('co-error')
      btn.disabled = true
      btn.textContent = 'Creando pedido...'
      errEl.classList.add('hidden')

      const items = getCart().map(i => ({ id: i.id, name: i.name, price: i.price, quantity: i.quantity }))
      const paymentMethod = (document.querySelector('input[name="pago"]:checked') as HTMLInputElement)?.value

      try {
        const order = await submitOrder(items)
        clearCart()

        if (paymentMethod === 'stripe') {
          // Stripe Checkout
          const { fetchWithAuth } = await import('../lib/api.ts')
          const stripeItems = getCart().map(i => ({
            quantity: i.quantity,
            price_data: {
              currency: 'usd',
              product_data: { name: i.name },
              unit_amount: Math.round(i.price * 100), // cents
            },
          }))
          // Re-create items from order since cart is cleared
          const orderItems = order.items || items
          const checkoutItems = orderItems.map((i: any) => ({
            quantity: i.quantity || 1,
            price_data: {
              currency: 'usd',
              product_data: { name: i.name || 'Producto' },
              unit_amount: Math.round((i.price || 0) * 100),
            },
          }))
          const session = await fetchWithAuth('/api/payments/create-checkout', {
            method: 'POST',
            body: JSON.stringify({ order_id: order.id, items: checkoutItems }),
          })
          if (session.url) {
            window.location.href = session.url
            return
          }
        }

        // Default: redirect to confirmation
        window.location.href = `/pedido/confirmado?id=${order.id}`
      } catch (e: any) {
        errEl.textContent = '❌ Error al crear pedido: ' + (e.message || 'desconocido')
        errEl.classList.remove('hidden')
        btn.disabled = false
        btn.textContent = 'Intentar de nuevo'
      }
    })

    renderSummary()
  </script>
</PublicLayout>
