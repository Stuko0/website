---
import PublicLayout from "../../layouts/PublicLayout.astro"
import Breadcrumbs from "../../components/ui/Breadcrumbs.astro"
import { Icon } from "astro-icon/components"
---

<PublicLayout title="Admin Pedidos">
  <div class="bg-primary pt-24 pb-6">
    <div class="container mx-auto px-4">
      <Breadcrumbs crumbs={[
        { label: "Inicio", href: "/" },
        { label: "Admin", href: "/admin" },
        { label: "Pedidos" }
      ]} />
      <h1 class="font-heading text-4xl text-accent">Gestión de Pedidos</h1>
    </div>
  </div>

  <div class="container mx-auto px-4 py-8">
    <div id="order-loading" class="text-center py-10 text-muted"><p>Cargando pedidos...</p></div>
    <div id="order-content" class="hidden space-y-4"></div>
  </div>

<script>
  import { fetchAdminOrders, updateOrderStatus } from '../../lib/api.ts'
  import { Icon } from 'astro-icon/components'

  const statusFlow: Record<string, string[]> = {
    pending: ['paid','cancelled'],
    paid: ['processing','cancelled'],
    processing: ['shipped'],
    shipped: ['delivered'],
    delivered: [],
    cancelled: [],
  }
  const statusColors: Record<string, string> = {
    pending:'bg-yellow-100 text-yellow-700', paid:'bg-blue-100 text-blue-700',
    processing:'bg-purple-100 text-purple-700', shipped:'bg-indigo-100 text-indigo-700',
    delivered:'bg-green-100 text-green-700', cancelled:'bg-red-100 text-red-600',
  }

  async function loadOrders() {
    document.getElementById('order-loading').classList.add('hidden')
    document.getElementById('order-content').classList.remove('hidden')
    const container = document.getElementById('order-content')
    try {
      const orders = await fetchAdminOrders()
      if (orders.length === 0) { container.innerHTML = '<p class="text-center text-muted py-10">No hay pedidos aún.</p>'; return }
      container.innerHTML = orders.map((o: any) => {
        const items = o.items || []
        const nextStatuses = statusFlow[o.status] || []
        return `<div class="border border-border rounded-sm p-4">
          <div class="flex flex-wrap items-start justify-between gap-3 mb-3">
            <div>
              <p class="font-semibold text-primary">Pedido #${(o.id||'').slice(0,8)}</p>
              <p class="text-xs text-muted">${o.created ? new Date(o.created).toLocaleString() : ''}</p>
              <p class="text-xs text-muted">Usuario: ${(o.user_id||'').slice(0,8)}</p>
            </div>
            <span class="px-3 py-1 text-sm font-semibold rounded-sm ${statusColors[o.status]||'bg-border text-muted'}">${o.status||'pending'}</span>
          </div>
          <div class="text-sm text-muted mb-3">${Array.isArray(items) ? items.map((i:any) => `${i.name||'Producto'} × ${i.quantity||1} — Bs ${((i.price||0)*(i.quantity||1)).toFixed(2)}`).join('<br/>') : '—'}</div>
          <div class="flex justify-between items-center border-t border-border pt-3">
            <span class="font-bold text-body">Total: Bs ${(o.total||0).toFixed(2)}</span>
            <div class="flex gap-2">
              ${nextStatuses.map(s => `<button onclick="updateStatus('${o.id}','${s}')" class="px-3 py-1 text-xs font-semibold uppercase tracking-wider rounded-sm border border-border hover:bg-accent/20 transition-colors">${s}</button>`).join('')}
            </div>
          </div>
        </div>`
      }).join('')
    } catch (e) { container.innerHTML = '<p class="text-center text-muted py-10">Error al cargar pedidos.</p>' }
  }

  ;(window as any).updateStatus = async (id: string, status: string) => {
    try { await updateOrderStatus(id, status); await loadOrders() }
    catch (e: any) { alert('Error: '+(e.message||'desconocido')) }
  }
  loadOrders()
</script>
</PublicLayout>
