---
import PublicLayout from "../layouts/PublicLayout.astro"
import Breadcrumbs from "../components/ui/Breadcrumbs.astro"
import { Icon } from "astro-icon/components"
---

<PublicLayout title="Admin Dashboard">
  <div class="bg-primary pt-24 pb-6">
    <div class="container mx-auto px-4">
      <Breadcrumbs crumbs={[
        { label: "Inicio", href: "/" },
        { label: "Panel de Administración" }
      ]} />
      <h1 class="font-heading text-4xl text-accent">Panel de Administración</h1>
    </div>
  </div>

  <div id="admin-content" class="container mx-auto px-4 py-8">
    <!-- Stats cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
      <div class="bg-white border border-border rounded-sm p-5">
        <div class="flex items-center justify-between mb-3">
          <Icon name="mdi:package-variant" class="text-3xl text-primary" />
          <span class="text-3xl font-bold text-heading" id="stat-products">0</span>
        </div>
        <h3 class="text-muted font-semibold">Productos</h3>
        <p class="text-xs text-green-600 font-semibold">+3 este mes</p>
      </div>
      <div class="bg-white border border-border rounded-sm p-5">
        <div class="flex items-center justify-between mb-3">
          <Icon name="mdi:cart-check" class="text-3xl text-accent" />
          <span class="text-3xl font-bold text-heading" id="stat-orders">0</span>
        </div>
        <h3 class="text-muted font-semibold">Pedidos</h3>
        <p class="text-xs text-green-600 font-semibold">+12 hoy</p>
      </div>
      <div class="bg-white border border-border rounded-sm p-5">
        <div class="flex items-center justify-between mb-3">
          <Icon name="mdi:account-group" class="text-3xl text-primary" />
          <span class="text-3xl font-bold text-heading" id="stat-users">0</span>
        </div>
        <h3 class="text-muted font-semibold">Usuarios</h3>
        <p class="text-xs text-green-600 font-semibold">+5 esta semana</p>
      </div>
      <div class="bg-white border border-border rounded-sm p-5">
        <div class="flex items-center justify-between mb-3">
          <Icon name="mdi:currency-usd" class="text-3xl text-accent" />
          <span class="text-3xl font-bold text-heading" id="stat-revenue">Bs 0</span>
        </div>
        <h3 class="text-muted font-semibold">Ingresos</h3>
        <p class="text-xs text-green-600 font-semibold">+22% vs mes ant.</p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <!-- Recent orders -->
      <div class="bg-white border border-border rounded-sm p-6">
        <h2 class="text-xl font-bold text-heading mb-4">Últimos Pedidos</h2>
        <div id="recent-orders" class="space-y-3">
          <p class="text-muted text-sm">Cargando pedidos...</p>
        </div>
        <a href="/admin/orders" class="block text-center mt-4 text-primary hover:text-accent font-semibold transition-colors text-sm">
          Ver todos los pedidos →
        </a>
      </div>

      <!-- Quick actions -->
      <div class="bg-white border border-border rounded-sm p-6">
        <h2 class="text-xl font-bold text-heading mb-4">Acciones Rápidas</h2>
        <div class="space-y-2">
          <a href="/admin/products" class="flex items-center gap-3 p-3 border border-border rounded-sm hover:bg-cream transition-colors">
            <Icon name="mdi:plus-circle" class="text-2xl text-primary" />
            <div>
              <p class="font-semibold text-heading">Agregar Producto</p>
              <p class="text-xs text-muted">Crear nuevo producto en el catálogo</p>
            </div>
          </a>
          <a href="/admin/recipes" class="flex items-center gap-3 p-3 border border-border rounded-sm hover:bg-cream transition-colors">
            <Icon name="mdi:book-open-variant" class="text-2xl text-primary" />
            <div>
              <p class="font-semibold text-heading">Gestionar Recetas</p>
              <p class="text-xs text-muted">Editar recetas del sitio</p>
            </div>
          </a>
          <a href="/admin/users" class="flex items-center gap-3 p-3 border border-border rounded-sm hover:bg-cream transition-colors">
            <Icon name="mdi:account-cog" class="text-2xl text-primary" />
            <div>
              <p class="font-semibold text-heading">Administrar Usuarios</p>
              <p class="text-xs text-muted">Ver y gestionar cuentas de clientes</p>
            </div>
          </a>
          <a href="/admin/supabase" class="flex items-center gap-3 p-3 border border-border rounded-sm hover:bg-cream transition-colors opacity-50 pointer-events-none">
            <Icon name="mdi:cog" class="text-2xl text-primary" />
            <div>
              <p class="font-semibold text-heading">Panel Supabase</p>
              <p class="text-xs text-muted">Próximamente</p>
            </div>
          </a>
        </div>
      </div>
    </div>
  </div>

  <div id="no-access" class="hidden container mx-auto px-4 py-8">
    <div class="max-w-md mx-auto text-center py-20">
      <Icon name="mdi:lock" class="text-6xl text-border mx-auto mb-4" />
      <h2 class="text-2xl font-semibold text-heading mb-2">Acceso Denegado</h2>
      <p class="text-muted mb-6">No tienes permisos para acceder a esta página</p>
      <a href="/" class="inline-block bg-primary text-cream px-8 py-3 font-bold uppercase tracking-wider hover:bg-primary-light transition-colors">
        Volver al Inicio
      </a>
    </div>
  </div>

  <script>
    import { isAuthenticated, isAdmin, fetchAdminStats, fetchAdminOrders, fetchAdminProducts, fetchWithAuth } from '../lib/api.ts'

    const adminContent = document.getElementById('admin-content')
    const noAccess = document.getElementById('no-access')

    // Check role from JWT first, then try API
    async function checkAccess() {
      if (!isAuthenticated()) {
        adminContent.classList.add('hidden')
        noAccess.classList.remove('hidden')
        return false
      }
      if (isAdmin()) return true
      // Fallback: check via API (role might have been updated in DB but JWT is stale)
      try {
        const profile = await fetchWithAuth('/api/profile')
        if (profile.role === 'admin' || profile.role === 'owner') {
          return true
        }
      } catch {}
      adminContent.classList.add('hidden')
      noAccess.classList.remove('hidden')
      return false
    }

    checkAccess().then(ok => { if (ok) loadStats() })

    async function loadStats() {
      try {
        const stats = await fetchAdminStats()
        document.getElementById('stat-products').textContent = (stats.products || 0).toString()
        document.getElementById('stat-orders').textContent = (stats.orders || 0).toString()
        document.getElementById('stat-users').textContent = (stats.users || 0).toString()
        document.getElementById('stat-revenue').textContent = `Bs ${(stats.revenue || 0).toFixed(2)}`
      } catch (e) {}

      try {
        const orders = await fetchAdminOrders()
        const recentOrdersEl = document.getElementById('recent-orders')
        if (!orders || orders.length === 0) {
          recentOrdersEl.innerHTML = '<p class="text-muted text-sm">No hay pedidos aún</p>'
        } else {
          recentOrdersEl.innerHTML = orders.slice(0, 5).map((order: any) => {
            const colors: Record<string,string> = { pending:'bg-yellow-100 text-yellow-700', paid:'bg-blue-100 text-blue-700', delivered:'bg-green-100 text-green-700', cancelled:'bg-red-100 text-red-600', processing:'bg-purple-100 text-purple-700', shipped:'bg-indigo-100 text-indigo-700' }
            return `<div class="flex items-center justify-between p-3 border border-border rounded-sm">
              <div>
                <p class="font-semibold text-heading text-sm">Pedido #${(order.id || '').slice(0, 8)}</p>
                <span class="inline-block px-2 py-0.5 text-xs font-semibold rounded-sm ${colors[order.status] || 'bg-border text-muted'}">${order.status || 'pending'}</span>
              </div>
              <p class="font-bold text-primary text-sm">Bs ${(order.total || 0).toFixed(2)}</p>
            </div>`
          }).join('')
        }
      } catch (e) {
        document.getElementById('recent-orders').innerHTML = '<p class="text-muted text-sm">No hay pedidos aún</p>'
      }

      try {
        const products = await fetchAdminProducts()
        document.getElementById('stat-products').textContent = Array.isArray(products) ? products.length.toString() : '0'
      } catch (e) {}
    }
  </script>
</PublicLayout>
