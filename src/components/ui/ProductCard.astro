---
import Badge from '../ui/Badge.astro'
import HoverOverlay from '../ui/HoverOverlay.astro'
import PriceDisplay from '../ui/PriceDisplay.astro'

export interface Props {
  product: {
    id: string
    name: string
    slug: string
    price: number
    compareAtPrice?: number
    image: string
    category?: string
    onSale?: boolean
    currency?: 'Bs' | '$'
  }
}
const { product } = Astro.props
const curr = product.currency || 'Bs'
---
<article class="group relative bg-white rounded-sm overflow-hidden shadow-sm hover:shadow-md transition-shadow">
  <a href={`/productos/${product.slug}`} class="block relative aspect-[4/5] overflow-hidden bg-border/30">
    <img
      src={product.image}
      alt={product.name}
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      loading="lazy"
    />
    {product.onSale && <Badge text="Sale" variant="sale" />}
    <HoverOverlay productSlug={product.slug} productId={product.id} />
  </a>
  <div class="p-4 text-center">
    {product.category && (
      <p class="text-xs uppercase tracking-wider text-muted/60 mb-1">{product.category}</p>
    )}
    <h3 class="font-semibold text-primary">
      <a href={`/productos/${product.slug}`} class="hover:text-accent transition-colors">
        {product.name}
      </a>
    </h3>
    <PriceDisplay price={product.price} compareAtPrice={product.compareAtPrice} currency={curr} />
  </div>
</article>
