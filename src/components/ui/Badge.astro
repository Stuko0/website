---
export interface Props {
  text: string
  variant?: 'sale' | 'new' | 'discount' | 'default'
}
const { text, variant = 'default' } = Astro.props
const variantClasses: Record<string, string> = {
  sale: 'bg-red-600 text-white',
  new: 'bg-accent text-primary',
  discount: 'bg-accent-orange text-white',
  default: 'bg-primary text-cream',
}
---
<span class="absolute top-3 left-3 z-10 px-3 py-1 text-xs font-bold uppercase tracking-wider rounded-sm {variantClasses[variant]}">
  {text}
</span>
