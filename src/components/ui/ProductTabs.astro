---
export interface Props {
  description: string
  additionalInfo?: { label: string; value: string }[]
}
const { description, additionalInfo = [] } = Astro.props
const tabs = [
  { id: 'description', label: 'Descripción' },
  { id: 'info', label: 'Información adicional' },
  { id: 'reviews', label: 'Reseñas' },
]
---
<div>
  <!-- Tab headers -->
  <div class="flex gap-8 border-b border-border mb-6">
    {tabs.map((tab, i) => (
      <button
        onclick={`window.switchTab('${tab.id}')`}
        data-tab={tab.id}
             class:list={{
               'pb-3 font-semibold transition-colors': true,
               'border-b-2 border-accent text-primary': i === 0,
               'text-muted hover:text-primary': i !== 0,
             }}
      >
        {tab.label}
      </button>
    ))}
  </div>

  <!-- Description -->
  <div id="tab-description" class="text-muted leading-relaxed max-w-3xl">
    <p>{description}</p>
  </div>

  <!-- Additional Info -->
  <div id="tab-info" class="hidden">
    {additionalInfo.length > 0 ? (
      <table class="text-muted">
        {additionalInfo.map(row => (
          <tr class="border-b border-border">
            <td class="py-2 pr-8 font-semibold text-primary">{row.label}</td>
            <td class="py-2">{row.value}</td>
          </tr>
        ))}
      </table>
    ) : (
      <p class="text-muted">No hay información adicional disponible.</p>
    )}
  </div>

  <!-- Reviews -->
  <div id="tab-reviews" class="hidden">
    <div class="flex items-center gap-4 mb-6">
      <div class="text-center">
        <p class="text-4xl font-bold text-heading">0.0</p>
        <div class="flex text-accent text-sm">★★★★★</div>
      </div>
      <p class="text-sm text-muted">Sé el primero en reseñar este producto</p>
    </div>
    <form class="max-w-lg space-y-4">
      <div>
        <label class="block text-sm font-semibold text-muted mb-1">Tu reseña</label>
        <textarea rows={4} class="w-full px-4 py-2 border-2 border-border rounded focus:border-accent focus:outline-none" placeholder="Comparte tu opinión..."></textarea>
      </div>
      <button class="bg-primary text-cream px-6 py-2 font-bold uppercase tracking-wider text-sm hover:bg-primary-light transition-colors">
        Enviar Reseña
      </button>
    </form>
  </div>
</div>

<script>
  window.switchTab = (tabId: string) => {
    document.querySelectorAll('[data-tab]').forEach(btn => {
      const isActive = btn.getAttribute('data-tab') === tabId
      btn.classList.toggle('border-b-2', isActive)
      btn.classList.toggle('border-accent', isActive)
      btn.classList.toggle('text-primary', isActive)
      btn.classList.toggle('text-muted', !isActive)
    })
    document.querySelectorAll('[id^="tab-"]').forEach(el => {
      el.classList.toggle('hidden', el.id !== `tab-${tabId}`)
    })
  }
</script>
