---
import PriceDisplay from './PriceDisplay.astro'

export interface Props {
  name: string
  category: string
  price: number
  compareAtPrice?: number
  description: string
  variants?: { label: string; price: number }[]
  slug: string
}
const { name, category, price, compareAtPrice, description, variants, slug } = Astro.props
const hasVariants = variants && variants.length > 0
---
<div>
  <!-- Category -->
  <p class="text-xs uppercase tracking-widest text-accent font-semibold mb-2">{category}</p>

  <!-- Title -->
  <h1 class="font-heading text-4xl lg:text-5xl text-primary mb-3">{name}</h1>

  <!-- Price -->
  <PriceDisplay price={price} compareAtPrice={compareAtPrice} />

  <!-- Tax note -->
  <p class="text-xs text-muted mt-1 mb-6">Impuesto incluido. Envío calculado en el checkout.</p>

  <!-- Short description -->
  <p class="text-muted leading-relaxed mb-6">{description}</p>

  <!-- Variants -->
  {hasVariants && (
    <div class="mb-5">
      <label class="block text-sm font-semibold text-muted mb-2">Presentación</label>
      <div class="flex flex-wrap gap-2">
        {variants.map((v, i) => (
          <button
            onclick={`window.selectVariant(${i}, ${v.price})`}
            data-variant
                 class:list={{
                   'px-4 py-2 border-2 rounded text-sm font-semibold transition-colors': true,
                   'border-accent bg-accent/10 text-primary': i === 0,
                   'border-border text-muted hover:border-accent hover:text-primary': i !== 0,
                 }}
          >
            {v.label}
          </button>
        ))}
      </div>
    </div>
  )}

  <!-- Quantity + CTA -->
  <div class="flex items-center gap-3 mb-5">
    <div class="flex items-center border-2 border-border rounded" id="qty-picker">
      <button onclick="window.updateQty(-1)" class="px-4 py-2 text-lg hover:bg-accent/20 transition-colors">−</button>
      <span class="px-4 py-2 text-lg font-semibold border-x-2 border-border min-w-[3rem] text-center" id="qty-display">1</span>
      <button onclick="window.updateQty(1)" class="px-4 py-2 text-lg hover:bg-accent/20 transition-colors">+</button>
    </div>
    <button
      data-add-cart-id={slug}
      data-add-cart-name={name}
      data-add-cart-price={price}
      onclick="window.addToCart(this)"
      class="flex-1 bg-primary text-cream px-6 py-3 font-bold uppercase tracking-wider text-sm hover:bg-primary-light transition-colors">
      Agregar al Carrito
    </button>
  </div>

  <!-- Buy it now -->
  <a href="/checkout"
    class="block w-full text-center border-2 border-primary text-primary px-6 py-3 font-bold uppercase tracking-wider text-sm hover:bg-primary hover:text-cream transition-colors mb-5">
    Comprar Ahora
  </a>

  <!-- Wishlist -->
  <button
    data-wishlist-id={slug}
    data-wishlist-name={name}
    data-wishlist-price={price}
    onclick="window.addToWishlist(this)"
    class="flex items-center gap-2 text-sm text-muted hover:text-accent transition-colors">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
    Añadir a favoritos
  </button>

  <!-- Social proof -->
  <div class="mt-6 pt-4 border-t border-border">
    <p class="text-xs text-muted animate-pulse" id="social-proof">
      <span id="viewer-count">12</span> personas están viendo esto ahora
    </p>
  </div>
</div>

<script>
  let qty = 1

  window.updateQty = (delta: number) => {
    qty = Math.max(1, Math.min(99, qty + delta))
    document.getElementById('qty-display').textContent = qty.toString()
  }

  window.selectVariant = (index: number, variantPrice: number) => {
    document.querySelectorAll('[data-variant]').forEach((btn, i) => {
      btn.classList.toggle('border-accent', i === index)
      btn.classList.toggle('bg-accent/10', i === index)
      btn.classList.toggle('text-primary', i === index)
      btn.classList.toggle('border-border', i !== index)
      btn.classList.toggle('hover:border-accent', i !== index)
      btn.classList.toggle('hover:text-primary', i !== index)
    })
  }

  // Random social proof counter
  let viewers = Math.floor(Math.random() * 15) + 5
  setInterval(() => {
    viewers += Math.random() > 0.5 ? 1 : -1
    viewers = Math.max(3, Math.min(30, viewers))
    document.getElementById('viewer-count').textContent = viewers.toString()
  }, 8000)
</script>
