---
export interface Props {
  productSlug: string
  productId?: string
}
const { productSlug, productId } = Astro.props
---
<div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
  <div class="flex gap-2 translate-y-4 group-hover:translate-y-0 transition-transform duration-300">
    <button onclick={`window.addToCart('${productId || productSlug}')`}
      class="w-10 h-10 rounded-full bg-white text-primary hover:bg-accent hover:text-primary flex items-center justify-center transition-colors shadow-md"
      title="Agregar al carrito">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z"/></svg>
    </button>
    <a href={`/productos/${productSlug}`}
      class="w-10 h-10 rounded-full bg-white text-primary hover:bg-accent hover:text-primary flex items-center justify-center transition-colors shadow-md"
      title="Ver producto">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
    </a>
    <button onclick={`window.addToWishlist('${productId || productSlug}')`}
      class="w-10 h-10 rounded-full bg-white text-primary hover:bg-accent hover:text-primary flex items-center justify-center transition-colors shadow-md"
      title="Añadir a favoritos">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
    </button>
  </div>
</div>
