---
import '../styles/global.css'
import Navbar from '../components/layout/Navbar.astro'
import Footer from '../components/layout/Footer.astro'
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Del Carpio</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body class="bg-cream font-sans text-body flex flex-col min-h-screen">
    <Navbar />
    <main class="flex-1 pt-5">
      <slot/>
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  details > summary {
    list-style: none;
  }
  details > summary::-webkit-details-marker {
    display: none;
  }
  details[open] summary ~ * {
    animation: fadeIn 0.3s ease-in-out;
  }

  @keyframes fadeIn {
    0% { opacity: 0; transform: translateY(-10px); }
    100% { opacity: 1; transform: translateY(0); }
  }
</style>

<script is:inline>
  window.addEventListener('scroll', function () {
    const nav = document.getElementById('mainNav');
    if (window.scrollY > 400) {
      nav.classList.remove('bg-opacity-70', 'absolute');
      nav.classList.add('fixed', 'bg-opacity-100');
      nav.style.backdropFilter = 'none';
    } else {
      nav.classList.add('bg-opacity-70', 'absolute');
      nav.classList.remove('fixed', 'bg-opacity-100');
      nav.style.backdropFilter = 'blur(12px) saturate(150%)';
    }
  });
</script>

<script is:inline>
  // ── Global addToCart ──
  window.addToCart = function(el) {
    const id = el.getAttribute('data-add-cart-id')
    const name = el.getAttribute('data-add-cart-name')
    const price = parseFloat(el.getAttribute('data-add-cart-price') || '0')
    const image = el.getAttribute('data-add-cart-image') || ''

    if (!id || !name) return

    // Import dynamically
    import('/src/lib/cart.ts').then(({ addToCart: addItem, getCartCount }) => {
      addItem({ id, name, price, image })
      const count = getCartCount()
      const badge = document.getElementById('cart-count')
      const mobileBadge = document.getElementById('mobile-cart-count')
      if (badge) badge.textContent = count.toString()
      if (mobileBadge) mobileBadge.textContent = count.toString()

      // Quick feedback
      el.classList.add('!bg-accent', '!text-primary')
      setTimeout(() => el.classList.remove('!bg-accent', '!text-primary'), 300)
    }).catch(() => {
      // Fallback without dynamic import — use localStorage directly
      const stored = localStorage.getItem('delcarpio_cart')
      const cart = stored ? JSON.parse(stored) : []
      const existing = cart.find((i: any) => i.id === id)
      if (existing) { existing.quantity += 1 }
      else { cart.push({ id, name, price, image, quantity: 1 }) }
      localStorage.setItem('delcarpio_cart', JSON.stringify(cart))
      window.dispatchEvent(new CustomEvent('cart-updated'))
    })
  }

  // ── Global addToWishlist ──
  window.addToWishlist = function(el) {
    const id = el.getAttribute('data-wishlist-id')
    const name = el.getAttribute('data-wishlist-name')
    const price = parseFloat(el.getAttribute('data-wishlist-price') || '0')
    const image = el.getAttribute('data-wishlist-image') || ''
    if (!id || !name) return

    const stored = localStorage.getItem('delcarpio_wishlist')
    let wishlist = stored ? JSON.parse(stored) : []
    const exists = wishlist.find((i: any) => i.id === id)

    if (exists) {
      wishlist = wishlist.filter((i: any) => i.id !== id)
      el.classList.remove('!bg-red-100')
      el.querySelector('svg')?.setAttribute('fill', 'none')
    } else {
      wishlist.push({ id, name, price, image })
      el.classList.add('!bg-red-100')
      el.querySelector('svg')?.setAttribute('fill', 'currentColor')
    }

    localStorage.setItem('delcarpio_wishlist', JSON.stringify(wishlist))
  }
</script>
